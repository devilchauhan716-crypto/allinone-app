* { box-sizing: border-box; font-family: system-ui, sans-serif; }
body { background: #0f172a; color: #e2e8f0; margin: 0; padding: 20px; }
.card { background: #1e293b; padding: 20px; border-radius: 12px; margin-bottom: 16px; max-width: 800px; margin-inline: auto; }
header { display: flex; justify-content: space-between; align-items: center; max-width: 800px; margin: 0 auto 20px; }
h1, h2 { margin: 0 0 12px; }
input, textarea, select { width: 100%; padding: 10px; margin: 6px 0; border-radius: 8px; border: 1px solid #334155; background: #0f172a; color: #e2e8f0; }
textarea { min-height: 80px; font-family: monospace; }
button { padding: 10px 16px; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; margin: 4px 4px 4px 0; }
button:hover { background: #2563eb; }
.row { display: flex; gap: 8px; }
.hidden { display: none; }
.doc-item, .consent-item, .form-item { background: #0f172a; padding: 10px; border-radius: 8px; margin: 6px 0; display: flex; justify-content: space-between; align-items: center; }
.tag { font-size: 12px; background: #334155; padding: 2px 8px; border-radius: 6px; }
.field { display: flex; gap: 8px; margin: 4px 0; align-items: center; }
.field label { flex: 0 0 140px; font-size: 14px; }
